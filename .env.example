# Simulator base URL (run.sh takes it as the first argument and overrides this)
SIM_URL=http://localhost:8000
# Simulated minutes per /sim/advance call; must be a positive multiple of 15
ADVANCE_MINUTES=60
# HTTP timeout in seconds
HTTP_TIMEOUT_S=30
# Retries for idempotent GET requests on transport errors / 5xx
HTTP_GET_RETRIES=3
# SQLite database. By default the controller uses one file per scenario,
# DB_DIR/<scenario>.db, and moves it aside automatically if the simulator was
# restarted (new world). Set DB_PATH only to force a specific file; the
# controller then refuses to run if that file belongs to a different world.
DB_DIR=data/worlds
# DB_PATH=data/my_run.db
LOG_LEVEL=INFO
