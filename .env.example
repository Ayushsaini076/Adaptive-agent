# Simulator base URL (run.sh takes it as the first argument and overrides this)
SIM_URL=http://localhost:8000
# Simulated minutes per /sim/advance call; must be a positive multiple of 15
ADVANCE_MINUTES=60
# HTTP timeout in seconds
HTTP_TIMEOUT_S=30
# Retries for idempotent GET requests on transport errors / 5xx
HTTP_GET_RETRIES=3
# SQLite database path (used from Milestone 2)
DB_PATH=data/controller.db
LOG_LEVEL=INFO
